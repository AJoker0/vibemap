# Local MongoDB from docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/vibemap

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (optional for email/password-only development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional map/geolocation integration
NEXT_PUBLIC_IPINFO_TOKEN=
