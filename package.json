{
  "name": "vibemap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm dev:full",
    "dev:next": "next dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:api": "node server/server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "dev:all": "pnpm dev:full",
    "dev:full": "node scripts/dev.mjs",
    "dev:vibes": "pnpm dev:full",
    "dev:clean": "pnpm docker:down && pnpm dev:vibes",
    "stop:all": "pnpm docker:down",
    "typecheck": "tsc --noEmit",
    "db:indexes": "node scripts/create_indexes.mjs",
    "db:migrate-passwords": "node scripts/migrate_passwords.mjs",
    "db:merge-duplicates": "node scripts/merge_duplicate_accounts.mjs",
    "test": "node --test tests/auth.test.cjs"
  },
